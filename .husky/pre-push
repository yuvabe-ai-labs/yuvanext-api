#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

BRANCH_NAME=$(git rev-parse --abbrev-ref HEAD)

echo "🧪 Validating branch name: $BRANCH_NAME"

if ! echo "$BRANCH_NAME" | grep -Eq "^(main|development|staging|feature\/[a-z0-9._-]+|fix\/[a-z0-9._-]+|bugfix\/[a-z0-9._-]+|hotfix\/[a-z0-9._-]+|chore\/[a-z0-9._-]+|release\/[a-z0-9._-]+|docs\/[a-z0-9._-]+)$"; then
  echo "❌ Invalid branch name!"
  echo "👉 Branch name must match formats like:"
  echo "   feature/my-cool-feature"
  echo "   fix/login-bug"
  echo "   release/v1.2.3"
  exit 1
fi

echo "✔️ Branch name is valid."
